# Glacier — env template. Copy to `.env` and edit.
#
# docker compose reads this file automatically. Values here override the
# defaults in compose.yaml.

# Host port that Glacier is published on (http://<host>:GLACIER_PORT).
GLACIER_PORT=5050

# Timezone used inside the container (affects log timestamps).
TZ=UTC

# FIRST music library folder (HOST path) mounted into the container at /music.
# On Windows a host path looks like:  MUSIC_DIR=D:\Music
# On macOS/Linux:                       MUSIC_DIR=/mnt/nas/Music
# You then add this library in Glacier → Libraries as the CONTAINER path  /music
MUSIC_DIR=./music

# OPTIONAL: second library mount. If you set this, also add the corresponding
# volume line in compose.yaml (see the commented examples there):
#   MUSIC_DIR_2=D:\Music\Archive
#MUSIC_DIR_2=
